{
  "name": "velmory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "node scripts/browser-check.mjs",
    "check:backend": "tsc -p tsconfig.backend.json",
    "verify": "npm run check:backend && npm test && npm run build",
    "test:live": "vitest run --config vitest.live.config.ts",
    "postbuild": "node scripts/generate-service-worker.mjs",
    "test:offline": "node scripts/offline-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "@tiptap/react": "^3.4.0",
    "@tiptap/starter-kit": "^3.4.0",
    "dexie": "^4.2.0",
    "libsodium-wrappers-sumo": "0.7.15",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
