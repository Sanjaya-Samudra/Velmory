# ==============================================================================
# SUPABASE EDGE FUNCTIONS LOCAL ENVIRONMENT SECRETS
# ==============================================================================
# Hosted Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY automatically in production.
# For local serving (`supabase functions serve`), populate these values.
# In production, set these via: `npx supabase secrets set KEY=VALUE`
# ==============================================================================

APP_URL=http://127.0.0.1:5173
SCHEDULER_SECRET=
BREVO_API_KEY=
MAIL_FROM=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
