# ==============================================================================
# VELMORY CONFIGURATION & DEPLOYMENT KEYS (.env.example)
# ==============================================================================
# Copy this file to `.env` or `.env.local` and fill in your keys.
# Never commit your actual `.env` or `.env.local` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Public)
# ------------------------------------------------------------------------------
# These variables are bundled into the client build and are publicly visible.
# Set these in your hosting dashboard (e.g., Cloudflare Pages / Vercel / Netlify).

# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase Public Anonymous Key (Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=

# Public deployment origin URL (e.g., https://velmory.pages.dev or http://127.0.0.1:5173)
VITE_PUBLIC_SITE_URL=http://127.0.0.1:5173

# Set to true only after verifying email confirmation and password reset delivery.
# Keep false while evaluating or when using local device vaults.
VITE_EMAIL_AUTH_READY=false


# ------------------------------------------------------------------------------
# 2. SUPABASE EDGE FUNCTIONS & SERVER SECRETS
# ------------------------------------------------------------------------------
# These are used server-side by the 5 Supabase Edge Functions:
# (account-delete, artwork, letter-dispatch, maintenance, media).
# On hosted Supabase, set these in: Project Settings -> Edge Functions -> Secrets
# Or via CLI: `npx supabase secrets set KEY=VALUE`

# Public frontend origin for CORS and email links (e.g., https://velmory.pages.dev)
APP_URL=http://127.0.0.1:5173

# Random secret token (at least 32 bytes/characters) securing pg_cron scheduler triggers.
# Example: generate with `openssl rand -hex 32` or any random 32+ character string
SCHEDULER_SECRET=

# Brevo (Sendinblue) API Key for delivering future letter notifications
BREVO_API_KEY=

# Verified sender email address in Brevo (e.g., letters@yourdomain.com)
MAIL_FROM=

# Supabase Service Role Key (Required for server-side maintenance, backup & restore scripts)
# NEVER prefix with VITE_ or expose to the frontend client!
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Project URL for CLI, scripts, and local testing
SUPABASE_URL=

# Supabase Anon Key for CLI and local testing
SUPABASE_ANON_KEY=


# ------------------------------------------------------------------------------
# 3. SUPABASE CUSTOM SMTP SETTINGS (Brevo / Sendinblue)
# ------------------------------------------------------------------------------
# Configure these in Supabase Dashboard -> Authentication -> SMTP Settings.
# Listed here for easy reference when configuring your project.

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Velmory
SMTP_SENDER_EMAIL=


# ------------------------------------------------------------------------------
# 4. SUPABASE VAULT SECRETS (For pg_cron / schedule.sql)
# ------------------------------------------------------------------------------
# Store these in Supabase Dashboard -> Project Settings -> Vault before running schedule.sql.
# The pg_cron scheduler reads these to trigger letter-dispatch and maintenance.

# Name in Vault: 'project_url' -> Value: https://<project-ref>.supabase.co
VAULT_PROJECT_URL=

# Name in Vault: 'scheduler_secret' -> Value: (same value as SCHEDULER_SECRET above)
VAULT_SCHEDULER_SECRET=


# ------------------------------------------------------------------------------
# 5. BACKUP, RESTORE & OPERATOR TOOLING (Optional / Advanced)
# ------------------------------------------------------------------------------
# Used by `scripts/backup.mjs` and `scripts/restore.mjs` for encrypted database dumps.

# 64-character hexadecimal key for AES-256-GCM backup encryption
# Example: generate with `openssl rand -hex 32`
VELMORY_BACKUP_KEY=

# PostgreSQL Database name for pg_dump / pg_restore (default: postgres)
PGDATABASE=postgres

# Confirmation flag required when running backup script: `yes`
VELMORY_MAINTENANCE_CONFIRMED=no

# Confirmation flag required when restoring to a disposable target: `EMPTY_DISPOSABLE_TARGET`
VELMORY_RESTORE_CONFIRM=

# Flags required by `npm run check:release` after passing hosted integration tests:
VELMORY_LIVE_TEST_CONFIRM=
VELMORY_LIVE_TESTS_PASSED=no
VELMORY_BACKUP_RESTORE_PASSED=no
