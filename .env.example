VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Only enable after testing real verification and recovery email delivery.
VITE_EMAIL_AUTH_READY=false
# Public deployment origin, for example https://velmory.pages.dev
VITE_PUBLIC_SITE_URL=
# `npm run check:release` also requires these shell-only evidence flags after
# the hosted integration suite and isolated restoration have actually passed:
# VELMORY_LIVE_TESTS_PASSED=yes
# VELMORY_BACKUP_RESTORE_PASSED=yes
# Server-only secrets: set through Supabase, never prefix with VITE_.
# BREVO_API_KEY=
# MAIL_FROM=
# APP_URL=
# SCHEDULER_SECRET=
